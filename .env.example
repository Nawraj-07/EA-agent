OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
ALLOWED_GMAIL_ACCOUNT=gaurang@rbhargavaassociates.in
# auto = Supabase when configured, else local token.json
# Render must use supabase
GMAIL_TOKEN_STORE=auto
GMAIL_TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
SESSION_HTTPS_ONLY=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=

# Scheduler (Tasks 6.1–6.2) — enable in only one process
ENABLE_SCHEDULER=false
GMAIL_SYNC_INTERVAL_MINUTES=15
GMAIL_SYNC_BATCH_SIZE=100
GMAIL_SYNC_MAX_BACKFILL_PAGES=3
GMAIL_NEWEST_PAGES=3
GMAIL_RECENT_SYNC_PAGES=5
GMAIL_RECONCILE_PAGES=10
GMAIL_ANALYZE_PER_RUN=100
GMAIL_ANALYZE_INTERVAL_MINUTES=1
# Auto-analyze only mail newer than this many days (0 = all pending)
GMAIL_AUTO_ANALYZE_NEWER_THAN_DAYS=2
# Resumable INBOX backfill window (Gmail after: date)
GMAIL_INBOX_BACKFILL_AFTER=2026/05/31
# Deprecated for list backfill (kept for docs compatibility)
GMAIL_SYNC_MAX_MESSAGES=50
BRIEFING_LOOKBACK_HOURS=24
BRIEFING_MAX_EMAILS=30
BRIEFING_HOUR_UTC=8
BRIEFING_MINUTE_UTC=0
# Calendar day for briefing history (today + prior 7 days)
BRIEFING_TIMEZONE=Asia/Kolkata
# Smart Daily Briefing 2.0 ranking (default off; additive, falls back to classic)
SMART_BRIEFING_ENABLED=false
# Pending-reply / follow-up detection (default off; uses stored threads + sent drafts)
PENDING_REPLY_DETECTION_ENABLED=false
# AI Follow-up Assistant (default off) — thresholds, attempt tracking, auto-resolve,
# Draft/Remind/Dismiss via Task 4 recommendation state. Does not auto-send.
AI_FOLLOWUP_ASSISTANT_ENABLED=false
# What Did I Miss? catch-up panel on Home (default off). Does not auto-send.
WHAT_DID_I_MISS_ENABLED=false
# CATCHUP_DEFAULT_LOOKBACK_HOURS=72
# Optional threshold overrides (hours) when assistant is enabled
# AI_FOLLOWUP_THRESHOLD_HIGH_HOURS=24
# AI_FOLLOWUP_THRESHOLD_MEDIUM_HOURS=48
# AI_FOLLOWUP_THRESHOLD_LOW_HOURS=72
# Smart Briefing Modes 2.0 (evening/weekly/monday) — all off by default
# Home Page filters fetch saved mode runs; enable these (+ ENABLE_SCHEDULER)
# only after smart_briefing_mode_runs migration is applied and verified.
# See docs/HOME_BRIEFING_MODE_FILTERS.md. Morning stays on BRIEFING_HOUR_UTC.
SMART_BRIEFING_MODES_ENABLED=false
EVENING_BRIEFING_ENABLED=false
WEEKLY_DIGEST_ENABLED=false
MONDAY_PLANNING_ENABLED=false
# Interactive Briefing recommendations (actions/status/snooze/draft) — off by default
INTERACTIVE_BRIEFING_ENABLED=false
# Optional tone for recommendation drafts (safe default: professional)
BRIEFING_PREFERRED_TONE=professional
# Task 5–6 personalization / feedback / adaptive ranking — all off by default
BRIEFING_PERSONALIZATION_ENABLED=false
BRIEFING_FEEDBACK_ENABLED=false
BRIEFING_ADAPTIVE_RANKING_ENABLED=false

# Ask My Inbox retrieval cap (1–30); broad summaries use CHAT_BROAD_SUMMARY_LIMIT
CHAT_RETRIEVAL_LIMIT=15
CHAT_BROAD_SUMMARY_LIMIT=40

# Local testing only — keep false in production
# Required for Refresh Inbox and /internal/briefing-now
ENABLE_MANUAL_SYNC=false

# Meta WhatsApp Cloud API (server-side only; never expose to frontend)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_API_VERSION=v25.0
# Smoke-test template (Meta sample or approved hello_world)
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_DAILY_BRIEFING=buddy_daily_briefing
WHATSAPP_TEMPLATE_IMPORTANT_EMAIL=buddy_important_email
WHATSAPP_TEMPLATE_MEETING=
WHATSAPP_TEMPLATE_PAYMENT=
