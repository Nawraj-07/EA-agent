OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
SESSION_SECRET=
SESSION_HTTPS_ONLY=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=

# Scheduler (Tasks 6.1–6.2) — enable in only one process
ENABLE_SCHEDULER=false
GMAIL_SYNC_INTERVAL_MINUTES=15
GMAIL_SYNC_BATCH_SIZE=100
GMAIL_SYNC_MAX_BACKFILL_PAGES=3
GMAIL_ANALYZE_PER_RUN=20
# Deprecated for list backfill (kept for docs compatibility)
GMAIL_SYNC_MAX_MESSAGES=50
BRIEFING_LOOKBACK_HOURS=24
BRIEFING_MAX_EMAILS=30
BRIEFING_HOUR_UTC=8
BRIEFING_MINUTE_UTC=0
# Calendar day for briefing history (today + prior 7 days)
BRIEFING_TIMEZONE=Asia/Kolkata

# Ask My Inbox retrieval cap (1–30)
CHAT_RETRIEVAL_LIMIT=15

# Local testing only — keep false in production
# Required for Refresh Inbox and /internal/briefing-now
ENABLE_MANUAL_SYNC=false
